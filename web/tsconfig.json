{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@engine/*": ["../src/engine/*"],
      "@types/*": ["../src/types/*"]
    }
  },
  "include": ["src", "../src/engine/types.ts", "../src/types.ts"]
}
